        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS: CLASS BOOKING\n    %% Start: Member muốn đặt/hủy lớp\n    %% End: Đăng ký thành công hoặc đã hủy\n    %% =====================================\n\n    %% ----- LANE 1: MEMBER -----\n    subgraph MEMBER[\&quot;👤 MEMBER\&quot;]\n        direction TB\n        START([● Start])\n        M1[\&quot;Login to system\&quot;]\n        M2{\&quot;Action?\&quot;}\n        M3[\&quot;View available classes&lt;br/&gt;&amp; schedule&lt;br/&gt;FE-09\&quot;]\n        M4[\&quot;Select class&lt;br/&gt;to register\&quot;]\n        M5[\&quot;Confirm registration&lt;br/&gt;FE-10\&quot;]\n        M6[\&quot;Go to reception desk\&quot;]\n        M7[\&quot;View registered classes\&quot;]\n        M8[\&quot;Select class&lt;br/&gt;to cancel\&quot;]\n        M9[\&quot;Confirm cancellation&lt;br/&gt;FE-11\&quot;]\n        M10[\&quot;Receive confirmation\&quot;]\n        END([◉ End])\n    end\n\n    %% ----- LANE 2: RECEPTIONIST -----\n    subgraph RECEPTION[\&quot;🧑‍💼 RECEPTIONIST\&quot;]\n        direction TB\n        R1[\&quot;Search member&lt;br/&gt;FE-33\&quot;]\n        R2[\&quot;View member&#39;s classes\&quot;]\n        R3{\&quot;Action?\&quot;}\n        R4[\&quot;Register class&lt;br/&gt;on behalf&lt;br/&gt;FE-36\&quot;]\n        R5[\&quot;Cancel class&lt;br/&gt;on behalf&lt;br/&gt;FE-36\&quot;]\n    end\n\n    %% ----- LANE 3: SYSTEM -----\n    subgraph SYSTEM[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        S1[\&quot;Query published classes&lt;br/&gt;with available slots\&quot;]\n        S2[\&quot;Validate booking:&lt;br/&gt;① Slot available?&lt;br/&gt;② Membership ACTIVE?&lt;br/&gt;③ Package covers sport?&lt;br/&gt;④ No duplicate booking?\&quot;]\n        S3{\&quot;Valid?\&quot;}\n        S4[\&quot;Create Class_Registration&lt;br/&gt;Status = BOOKED&lt;br/&gt;FE-10\&quot;]\n        S5[\&quot;Decrement&lt;br/&gt;available slots\&quot;]\n        S6[\&quot;Query member&#39;s&lt;br/&gt;registrations\&quot;]\n        S7[\&quot;Update Status&lt;br/&gt;= CANCELLED&lt;br/&gt;FE-11\&quot;]\n        S8[\&quot;Restore slot&lt;br/&gt;capacity + 1\&quot;]\n        S9[\&quot;Notify Member &amp; Coach\&quot;]\n    end\n\n    %% ===== BOOKING FLOW =====\n    START --&gt; M1 --&gt; M2\n    M2 --&gt;|Book online| S1 --&gt; M3 --&gt; M4 --&gt; M5 --&gt; S2 --&gt; S3\n    S3 --&gt;|No| M3\n    S3 --&gt;|Yes| S4 --&gt; S5 --&gt; S9\n\n    %% ===== BOOKING AT COUNTER =====\n    M2 --&gt;|Book at counter| M6 --&gt; R1 --&gt; R2 --&gt; R3\n    R3 --&gt;|Register| R4 --&gt; S2\n    R3 --&gt;|Cancel| R5 --&gt; S7\n\n    %% ===== CANCELLATION FLOW =====\n    M2 --&gt;|Cancel class| S6 --&gt; M7 --&gt; M8 --&gt; M9 --&gt; S7 --&gt; S8 --&gt; S9\n\n    S9 --&gt; M10 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef decision fill:#FFF2CC,stroke:#BF9000,color:#7F6000,stroke-width:1.5px\n    classDef success fill:#D9EAD3,stroke:#6AA84F,color:#274E13,stroke-width:1px\n    classDef failure fill:#F4CCCC,stroke:#CC0000,color:#660000,stroke-width:1px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class M1,M3,M4,M5,M6,M7,M8,M9,M10,R1,R2,R4,R5,S1,S2,S4,S5,S6,S9 process\n    class M2,R3,S3 decision\n    class S4,S5 success\n    class S7,S8 failure\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-162">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
