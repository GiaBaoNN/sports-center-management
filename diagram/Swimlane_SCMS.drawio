        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS 2: ACCOUNT ADMINISTRATION\n    %% Start khi Manager cần quản trị\n    %% End khi hoàn tất thao tác\n    %% =====================================\n\n    subgraph MANAGER[\&quot;👔 CENTER MANAGER\&quot;]\n        direction TB\n        START([● Start])\n        CM2[\&quot;Access admin dashboard\&quot;]\n        CM3{\&quot;Manage&lt;br/&gt;which list?\&quot;}\n        CM4[\&quot;Members list&lt;br/&gt;View / Lock&lt;br/&gt;FE-02\&quot;]\n        CM5[\&quot;Coaches list&lt;br/&gt;Add / Edit / Lock&lt;br/&gt;FE-02\&quot;]\n        CM6[\&quot;Receptionists list&lt;br/&gt;Add / Edit / Lock&lt;br/&gt;FE-02\&quot;]\n        CM7[\&quot;Assign role&lt;br/&gt;permissions&lt;br/&gt;FE-31\&quot;]\n        END([◉ End])\n    end\n\n    subgraph SYSTEM2[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        SY1[\&quot;Validate changes\&quot;]\n        SY2[\&quot;Save account &amp;&lt;br/&gt;permission updates\&quot;]\n    end\n\n    START --&gt; CM2 --&gt; CM3\n    CM3 --&gt;|Members| CM4\n    CM3 --&gt;|Coaches| CM5\n    CM3 --&gt;|Receptionists| CM6\n    CM4 --&gt; CM7\n    CM5 --&gt; CM7\n    CM6 --&gt; CM7\n    CM7 --&gt; SY1 --&gt; SY2 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef decision fill:#FFF2CC,stroke:#BF9000,color:#7F6000,stroke-width:1.5px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class CM2,CM4,CM5,CM6,CM7,SY1,SY2 process\n    class CM3 decision\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-55">
