        <mxCell id="2LFEs74AMrHpGwDwDqqT-79" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2 style=&quot;--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: light-dark(#fff, #000000); --tw-ring-color: light-dark(#3b82f680, #4c89ec80); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; box-sizing: border-box; border: 0px solid rgb(229, 231, 235); margin: 0px 0px 1em; font-family: monaSans, &amp;quot;monaSans Fallback&amp;quot;, ui-sans-serif, system-ui, sans-serif; letter-spacing: -0.025em; color: rgb(37, 37, 35); line-height: 1.33333; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(252, 250, 248); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 100px;&quot;&gt;Membership Journey&lt;/font&gt;&lt;/h2&gt;" vertex="1">
          <mxGeometry height="64" width="1050" x="487" y="2349" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS: MEMBERSHIP LIFECYCLE\n    %% Start: Member muốn mua/gia hạn gói\n    %% End: Membership ACTIVE hoặc hết hạn\n    %% =====================================\n\n    %% ----- LANE 1: MEMBER -----\n    subgraph MEMBER[\&quot;👤 MEMBER\&quot;]\n        direction TB\n        START([● Start])\n        M1[\&quot;Login to system\&quot;]\n        M2{\&quot;Action?\&quot;}\n        M3[\&quot;View membership packages&lt;br/&gt;Fee, Duration, Benefits&lt;br/&gt;FE-03\&quot;]\n        M4[\&quot;Select package&lt;br/&gt;Register / Renew&lt;br/&gt;FE-04\&quot;]\n        M5[\&quot;Go to reception desk\&quot;]\n        M6[\&quot;View membership status&lt;br/&gt;&amp; expiration date&lt;br/&gt;FE-05\&quot;]\n        M7[\&quot;Receive activation result\&quot;]\n        M8[\&quot;Receive expiry reminder&lt;br/&gt;FE-06\&quot;]\n        M9{\&quot;Renew?\&quot;}\n        END([◉ End])\n    end\n\n    %% ----- LANE 2: RECEPTIONIST -----\n    subgraph RECEPTION[\&quot;🧑‍💼 RECEPTIONIST\&quot;]\n        direction TB\n        R1[\&quot;Search member&lt;br/&gt;FE-33\&quot;]\n        R2[\&quot;View membership info&lt;br/&gt;&amp; current status&lt;br/&gt;FE-05\&quot;]\n        R3[\&quot;Register / Renew&lt;br/&gt;membership at counter&lt;br/&gt;FE-34\&quot;]\n    end\n\n    %% ----- LANE 3: SYSTEM -----\n    subgraph SYSTEM[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        S1[\&quot;Load active packages&lt;br/&gt;from Membership_Package\&quot;]\n        S2[\&quot;Create membership record&lt;br/&gt;Status = PENDING\&quot;]\n        P1[[\&quot;Payment Process&lt;br/&gt;see Flow 3\&quot;]]\n        S3{\&quot;Payment&lt;br/&gt;PAID?\&quot;}\n        S4{\&quot;Transaction&lt;br/&gt;type?\&quot;}\n        S5[\&quot;Activate membership&lt;br/&gt;Status = ACTIVE&lt;br/&gt;Set start &amp; end date\&quot;]\n        S6[\&quot;Extend membership&lt;br/&gt;end = MAX(end, today)&lt;br/&gt;+ duration\&quot;]\n        S7[\&quot;Keep PENDING&lt;br/&gt;Not activated\&quot;]\n        S8[\&quot;Notify member\&quot;]\n        S9[\&quot;Query membership&lt;br/&gt;status\&quot;]\n        S10[\&quot;Daily scheduled job:&lt;br/&gt;≤ 7 days → remind&lt;br/&gt;Passed → set EXPIRED&lt;br/&gt;FE-06\&quot;]\n    end\n\n    %% ===== MEMBER: BUY / RENEW ONLINE =====\n    START --&gt; M1 --&gt; M2\n    M2 --&gt;|Buy online| S1 --&gt; M3 --&gt; M4 --&gt; S2\n\n    %% ===== MEMBER: BUY AT COUNTER =====\n    M2 --&gt;|Buy at counter| M5 --&gt; R1 --&gt; R2 --&gt; R3 --&gt; S2\n\n    %% ===== SHARED: PAYMENT &amp; ACTIVATION =====\n    S2 --&gt; P1 --&gt; S3\n    S3 --&gt;|Yes| S4\n    S3 --&gt;|No| S7 --&gt; S8\n    S4 --&gt;|New| S5 --&gt; S8\n    S4 --&gt;|Renewal| S6 --&gt; S8\n    S8 --&gt; M7\n\n    %% ===== CHECK STATUS =====\n    M2 --&gt;|Check status| S9 --&gt; M6\n\n    %% ===== EXPIRY REMINDER =====\n    S5 -.-&gt;|monitor| S10\n    S6 -.-&gt;|monitor| S10\n    S10 --&gt; M8 --&gt; M9\n    M9 --&gt;|Yes| M2\n    M9 --&gt;|No| END\n\n    M6 --&gt; END\n    M7 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef decision fill:#FFF2CC,stroke:#BF9000,color:#7F6000,stroke-width:1.5px\n    classDef success fill:#D9EAD3,stroke:#6AA84F,color:#274E13,stroke-width:1px\n    classDef failure fill:#F4CCCC,stroke:#CC0000,color:#660000,stroke-width:1px\n    classDef subprocess fill:#DDEBF7,stroke:#2F5597,color:#1F3864,stroke-width:1.5px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class M1,M3,M4,M5,M6,M7,M8,R1,R2,R3,S1,S2,S8,S9,S10 process\n    class M2,M9,S3,S4 decision\n    class S5,S6 success\n    class S7 failure\n    class P1 subprocess\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-80">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
