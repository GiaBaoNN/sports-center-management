        <mxCell id="2LFEs74AMrHpGwDwDqqT-222" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: light-dark(#fff, #000000); --tw-ring-color: light-dark(#3b82f680, #4c89ec80); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; box-sizing: border-box; border: 0px solid rgb(229, 231, 235); margin: 1.6em 0px 0.6em; font-family: monaSans, &amp;quot;monaSans Fallback&amp;quot;, ui-sans-serif, system-ui, sans-serif; letter-spacing: -0.025em; color: rgb(37, 37, 35); line-height: 1.6; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(252, 250, 248); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 100px;&quot;&gt;Manager Setup Class&lt;/font&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="79" width="1285" x="2973" y="5323" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS: CLASS SETUP\n    %% Start: Manager cần tạo lớp mới\n    %% End: Lớp đã được publish\n    %% =====================================\n\n    subgraph MANAGER[\&quot;👔 CENTER MANAGER\&quot;]\n        direction TB\n        START([● Start])\n        CM1[\&quot;Access class management\&quot;]\n        CM2[\&quot;Select sport&lt;br/&gt;FE-07\&quot;]\n        CM3[\&quot;Select room&lt;br/&gt;&amp; capacity&lt;br/&gt;FE-07\&quot;]\n        CM4[\&quot;Set schedule&lt;br/&gt;Day / Time / Period&lt;br/&gt;FE-08\&quot;]\n        CM5[\&quot;Assign coach&lt;br/&gt;FE-13\&quot;]\n        CM6[\&quot;Confirm &amp; publish\&quot;]\n        END([◉ End])\n    end\n\n    subgraph SYSTEM3[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        SY1[\&quot;Validate conflicts:&lt;br/&gt;- Room not double-booked&lt;br/&gt;- Coach not double-booked\&quot;]\n        SY2{\&quot;Valid?\&quot;}\n        SY3[\&quot;Save Class + Schedule\&quot;]\n        SY4[\&quot;Publish to&lt;br/&gt;available classes\&quot;]\n    end\n\n    START --&gt; CM1 --&gt; CM2 --&gt; CM3 --&gt; CM4 --&gt; CM5 --&gt; CM6 --&gt; SY1 --&gt; SY2\n    SY2 --&gt;|Conflict| CM4\n    SY2 --&gt;|Valid| SY3 --&gt; SY4 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef decision fill:#FFF2CC,stroke:#BF9000,color:#7F6000,stroke-width:1.5px\n    classDef success fill:#D9EAD3,stroke:#6AA84F,color:#274E13,stroke-width:1px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class CM1,CM2,CM3,CM4,CM5,CM6,SY1,SY3,SY4 process\n    class SY2 decision\n    class SY3,SY4 success\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-223">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
