        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS 1: USER LIFECYCLE\n    %% Start khi Member muốn có account\n    %% End khi account sẵn sàng sử dụng\n    %% =====================================\n\n    %% ----- LANE 1: MEMBER -----\n    subgraph MEMBER[\&quot;👤 MEMBER\&quot;]\n        direction TB\n        START([● Start])\n        M2{\&quot;Has account?\&quot;}\n        M3{\&quot;Register via?\&quot;}\n        M4[\&quot;Fill online registration&lt;br/&gt;Name, Email, Phone, Password&lt;br/&gt;FE-01\&quot;]\n        M5[\&quot;Go to reception desk\&quot;]\n        M6[\&quot;Login to system\&quot;]\n        M7[\&quot;Update personal profile&lt;br/&gt;FE-01\&quot;]\n        M8[\&quot;Receive confirmation\&quot;]\n        END([◉ End])\n    end\n\n    %% ----- LANE 2: RECEPTIONIST -----\n    subgraph RECEPTION[\&quot;🧑‍💼 RECEPTIONIST\&quot;]\n        direction TB\n        R1[\&quot;Search member&lt;br/&gt;FE-33\&quot;]\n        R2{\&quot;Member&lt;br/&gt;found?\&quot;}\n        R3[\&quot;Register new member&lt;br/&gt;account at counter&lt;br/&gt;FE-34\&quot;]\n        R4[\&quot;View member info\&quot;]\n        R5[\&quot;Update member&lt;br/&gt;personal info&lt;br/&gt;FE-01\&quot;]\n    end\n\n    %% ----- LANE 3: SYSTEM -----\n    subgraph SYSTEM[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        S1[\&quot;Validate registration&lt;br/&gt;Email/Phone unique&lt;br/&gt;Password strength\&quot;]\n        S2{\&quot;Valid?\&quot;}\n        S3[\&quot;Create account&lt;br/&gt;Role = MEMBER\&quot;]\n        S4[\&quot;Create account&lt;br/&gt;at counter&lt;br/&gt;Send credentials\&quot;]\n        S5[\&quot;Authenticate&lt;br/&gt;JWT + Spring Security\&quot;]\n        S6{\&quot;Credentials&lt;br/&gt;correct?\&quot;}\n        S7[\&quot;Issue JWT token&lt;br/&gt;Load permissions&lt;br/&gt;FE-31\&quot;]\n        S8[\&quot;Validate &amp; save&lt;br/&gt;profile changes\&quot;]\n    end\n\n    %% ===== ONLINE REGISTRATION =====\n    START --&gt; M2\n    M2 --&gt;|No| M3\n    M3 --&gt;|Online| M4 --&gt; S1 --&gt; S2\n    S2 --&gt;|Invalid| M4\n    S2 --&gt;|Valid| S3 --&gt; M8\n\n    %% ===== COUNTER REGISTRATION =====\n    M3 --&gt;|At counter| M5 --&gt; R1 --&gt; R2\n    R2 --&gt;|No| R3 --&gt; S4 --&gt; M8\n    R2 --&gt;|Yes| R4 --&gt; R5 --&gt; S8 --&gt; M8\n\n    %% ===== LOGIN =====\n    M2 --&gt;|Yes| M6 --&gt; S5 --&gt; S6\n    S6 --&gt;|Wrong| M6\n    S6 --&gt;|Correct| S7 --&gt; M7 --&gt; S8\n\n    %% ===== END =====\n    M8 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef decision fill:#FFF2CC,stroke:#BF9000,color:#7F6000,stroke-width:1.5px\n    classDef success fill:#D9EAD3,stroke:#6AA84F,color:#274E13,stroke-width:1px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class M4,M5,M6,M7,M8,R1,R3,R4,R5,S1,S4,S5,S7,S8 process\n    class M2,M3,R2,S2,S6 decision\n    class S3,S4,S7 success\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-2">
