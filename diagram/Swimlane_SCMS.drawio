        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================\n    %% PROCESS: COACH SCHEDULE VIEW\n    %% Start: Coach cần xem lịch dạy\n    %% End: Coach có đủ thông tin\n    %% =====================================\n\n    subgraph COACH[\&quot;🏋️ COACH\&quot;]\n        direction TB\n        START([● Start])\n        C1[\&quot;Login to system\&quot;]\n        C2[\&quot;View teaching schedule&lt;br/&gt;FE-12\&quot;]\n        C3[\&quot;Select class\&quot;]\n        C4[\&quot;View class details&lt;br/&gt;&amp; member list&lt;br/&gt;FE-12\&quot;]\n        END([◉ End])\n    end\n\n    subgraph SYSTEM4[\&quot;⚙️ SYSTEM\&quot;]\n        direction TB\n        SY1[\&quot;Authenticate&lt;br/&gt;JWT + Role=COACH\&quot;]\n        SY2[\&quot;Query classes&lt;br/&gt;WHERE coach_id = current\&quot;]\n        SY3[\&quot;Query registered members&lt;br/&gt;in selected class\&quot;]\n    end\n\n    START --&gt; C1 --&gt; SY1 --&gt; SY2 --&gt; C2 --&gt; C3 --&gt; SY3 --&gt; C4 --&gt; END\n\n    %% ===== STYLES =====\n    classDef process fill:#FFFFFF,stroke:#555555,color:#222222,stroke-width:1px\n    classDef terminator fill:#D9EAD3,stroke:#38761D,color:#274E13,stroke-width:2px\n\n    class C1,C2,C3,C4,SY1,SY2,SY3 process\n    class START,END terminator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2LFEs74AMrHpGwDwDqqT-251">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
